{
  // The main site as static files on Cloudflare. esbjugconsult.com/jev* is served by a
  // separate Worker (../jev), whose more specific route takes precedence over this one.
  "name": "esbjug-consult",
  "compatibility_date": "2026-09-01",
  "main": ".worker/index.js",
  // Before every deploy: copy the pages behind the login into kunde/ from the private repo
  // cloned one folder up. The deploy stops if that repo is missing, so the area is never wiped.
  "build": { "command": "node ../verktoy/kunde-sync.mjs" },
  // run_worker_first: www is redirected before any file is served.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // Only the real domain; no parallel *.workers.dev copy.
  "workers_dev": false,
  // All of esbjugconsult.com except /jev*, which the more specific route in ../jev takes.
  // Live chat: one Durable Object holds every socket and the conversations (SQLite storage).
  // Klart: prøveperioder, lisenser og maskiner bak aktiveringssiden (.worker/klart.js).
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatHub" },
      { "name": "KLART", "class_name": "KlartLager" }
    ]
  },
  // Files in the chat (audio, images, documents), served with range support from /chat/file/<key>.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "esbjug-chat-files" }],
  "migrations": [
    { "tag": "chat-v1", "new_sqlite_classes": ["ChatHub"] },
    { "tag": "klart-v1", "new_sqlite_classes": ["KlartLager"] }
  ],
  // Push to the owner's iPhone app. Secrets (wrangler secret put): ADMIN_TOKEN, APNS_KEY, APNS_KEY_ID.
  "vars": {
    "APNS_TEAM_ID": "N5BKVM258S",
    "APNS_TOPIC": "deviatehigh.EsbjugChat",
    // Klart. Tom STRIPE_PRICE_ID = «Kjøp åpner snart». KLART_MVA "auto" = Stripe Tax legger på mva.
    // Hemmeligheter (wrangler secret put): KLART_LISENSNOKKEL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
    // Testpris fra Stripes sandkasse («Klart (test)»). Byttes med den ekte live-prisen ved lansering.
    "STRIPE_PRICE_ID": "price_1UTKGlKHn2XFxWXM9gD79OHl",
    "KLART_MASKINER": "2",
    "KLART_MVA": ""
  },
  "routes": [
    { "pattern": "esbjugconsult.com/*", "zone_name": "esbjugconsult.com" },
    { "pattern": "www.esbjugconsult.com/*", "zone_name": "esbjugconsult.com" }
  ]
}
