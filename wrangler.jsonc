{
  // The main site as static files on Cloudflare. esbjugconsult.com/jev* is served by a
  // separate Worker (../jev), whose more specific route takes precedence over this one.
  "name": "esbjug-consult",
  "compatibility_date": "2026-09-01",
  "main": ".worker/index.js",
  // Before every deploy: copy the pages behind the login into kunde/ from the private repo
  // cloned one folder up. The deploy stops if that repo is missing, so the area is never wiped.
  "build": { "command": "node ../verktoy/kunde-sync.mjs" },
  // run_worker_first: www is redirected before any file is served.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // Only the real domain; no parallel *.workers.dev copy.
  "workers_dev": false,
  // All of esbjugconsult.com except /jev*, which the more specific route in ../jev takes.
  // Live chat: one Durable Object holds every socket and the conversations (SQLite storage).
  // Klart: prøveperioder, lisenser og maskiner bak aktiveringssiden (.worker/klart.js).
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatHub" },
      { "name": "KLART", "class_name": "KlartLager" }
    ]
  },
  // Files in the chat (audio, images, documents), served with range support from /chat/file/<key>.
  // KLART_FILER: installasjonsfilene til Klart (DMG og EXE), servert fra /GDPR/last-ned/mac og /windows.
  // Jev (TypeSafe) via jev-workeren, som har nøkkelen: søket i avspillingen på /hjem/ (POST /chat/sok).
  // Hemmeligheten INTERN_KEY er den samme i begge workerne.
  "services": [{ "binding": "JEV", "service": "esbjug-jev" }],
  // E-post ut (Cloudflare Email Sending, slått på for esbjugconsult.com): bestillinger og lisensnøkler for Klart, FrostCopy-fakturaer og lisenser.
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "esbjug-chat-files" },
    { "binding": "KLART_FILER", "bucket_name": "klart-nedlasting" }
  ],
  "migrations": [
    { "tag": "chat-v1", "new_sqlite_classes": ["ChatHub"] },
    { "tag": "klart-v1", "new_sqlite_classes": ["KlartLager"] }
  ],
  // Push to the owner's iPhone app. Secrets (wrangler secret put): ADMIN_TOKEN, APNS_KEY, APNS_KEY_ID.
  "vars": {
    "APNS_TEAM_ID": "N5BKVM258S",
    "APNS_TOPIC": "deviatehigh.EsbjugChat",
    // Klart. Ingen betaling går gjennom Stripe (20.11.2026): alt bestilles på faktura, se .worker/klart.js.
    // Hemmeligheter (wrangler secret put): KLART_LISENSNOKKEL og KLART_PRISER. STRIPE_SECRET_KEY og
    // STRIPE_WEBHOOK_SECRET brukes bare av webhooken for kjøp som ble gjort før det.
    // "pause" stenger nedlastingen av Klart (se handleNedlasting). Tom = åpen.
    "KLART_NEDLASTING": "",
    // "ja" = bare «Kommer snart» på /klart. Aktiveringen og /klart/api/ går som før.
    "KLART_SNART": "",
    "KLART_MASKINER": "2",
    // Prissiden (/klart/pris/). Prisene er hemmeligheten KLART_PRISER (verktoy/klart-priser.sh i det
    // private repoet). E-posten om bestillinger og lisensnøkler går med bindingen EMAIL over. Avsenderen
    // her og RESEND_API_KEY gjelder bare e-postene fra Stripe-webhooken (eldre kjøp). Alt som sendes,
    // står også i utboksen (GET /klart/api/utboks med ADMIN_TOKEN).
    "KLART_EPOST_FRA": ""
  },
  "routes": [
    { "pattern": "esbjugconsult.com/*", "zone_name": "esbjugconsult.com" },
    { "pattern": "www.esbjugconsult.com/*", "zone_name": "esbjugconsult.com" }
  ]
}
